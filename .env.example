# =============================================
# Auto Ticket System — Environment Variables
# এই ফাইল কপি করে .env নাম দিন:  cp .env.example .env
# =============================================

# ---------- Brevo SMTP ----------
# SMTP_HOST=smtp-relay.brevo.com
# লোকালে 587 চলবে। Render free tier-এ 587 ব্লক — সেখানে 2525 দিন
# SMTP_PORT=587
# Brevo > SMTP & API > SMTP ট্যাবে দেখানো Login (যেমন 8a1b2c001@smtp-brevo.com)
# SMTP_USER=your_brevo_login
# Brevo-র SMTP key (API key নয়!)
# SMTP_PASS=your_brevo_smtp_key
# Brevo-তে verified sender ইমেইল — এই ঠিকানা থেকে মেইল যাবে
# SMTP_FROM=you@yourdomain.com
# SMTP_FROM_NAME=Auto Ticket System

# ---------- Database ----------
# compose.yaml-এর লোকাল PostgreSQL
DATABASE_URL=postgres://ticket_app:change-this-password@localhost:55432/ticketdb?sslmode=disable
POSTGRES_PASSWORD=change-this-password

# ---------- Server ----------
PORT=18080

# ---------- Groq AI ticket assistant ----------
# Put the rotated Groq API key in your ignored local .env file or server secret store.
# Never commit an API key to Git or put it in browser JavaScript.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---------- Initial application administrator ----------
# Required on first startup. Created only when the users table is empty.
# Manage later accounts and password changes at /admin/users.
APP_USER=admin
# Use a unique password, ideally 12+ characters.
APP_PASS=change-this-password
SESSION_COOKIE_SECURE=false
# Optional for authenticator MFA. Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=
# Optional inbound mail integration. Generate a secret of at least 32 characters.
# Provider webhook signs: unix_timestamp + "." + raw JSON body using HMAC-SHA256.
EMAIL_WEBHOOK_SECRET=

# Local Jenkins login. Choose a unique password before exposing Jenkins outside this PC.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-this-password

# ---------- Local backup worker ----------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# ---------- Optional SLA business calendar ----------
# When enabled, priority target hours count only within the local workday.
SLA_BUSINESS_HOURS=false
SLA_BUSINESS_START=09:00
SLA_BUSINESS_END=17:00
SLA_BUSINESS_DAYS=Mon,Tue,Wed,Thu,Fri
# Comma-separated local dates, for example: 2026-12-16,2027-02-21
SLA_HOLIDAYS=

# Local/private employee workbook path; keep the file out of public Git repos.
# EXCEL_PATH=employees.xlsx
# SQLITE_PATH=tickets.db
# APP_TIMEZONE=Asia/Dhaka
# ATTACHMENT_DIR=attachments
