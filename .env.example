# =============================================
# Auto Ticket System — Environment Variables
# এই ফাইল কপি করে .env নাম দিন:  cp .env.example .env
# =============================================

# ---------- Brevo SMTP ----------
# SMTP_HOST=smtp-relay.brevo.com
# লোকালে 587 চলবে। Render free tier-এ 587 ব্লক — সেখানে 2525 দিন
# SMTP_PORT=587
# Brevo > SMTP & API > SMTP ট্যাবে দেখানো Login (যেমন 8a1b2c001@smtp-brevo.com)
# SMTP_USER=your_brevo_login
# Brevo-র SMTP key (API key নয়!)
# SMTP_PASS=your_brevo_smtp_key
# Brevo-তে verified sender ইমেইল — এই ঠিকানা থেকে মেইল যাবে
# SMTP_FROM=you@yourdomain.com
# SMTP_FROM_NAME=Auto Ticket System

# ---------- Database ----------
# compose.yaml-এর লোকাল PostgreSQL
DATABASE_URL=postgres://ticket_app:local_ticket_password@localhost:55432/ticketdb?sslmode=disable

# ---------- Server ----------
PORT=18080

# ---------- ঐচ্ছিক ----------
# অনলাইনে রাখলে অবশ্যই দিন — পুরো সাইটে লগইন লাগবে
# APP_USER=admin
# APP_PASS=strong-password-here

# Local/private employee workbook path; keep the file out of public Git repos.
# EXCEL_PATH=employees.xlsx
# SQLITE_PATH=tickets.db
# APP_TIMEZONE=Asia/Dhaka
