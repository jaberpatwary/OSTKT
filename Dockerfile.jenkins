FROM jenkins/jenkins:lts-jdk21

USER root
ARG GO_VERSION=1.27.4
ARG GO_SHA256=7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl tar \
    && curl -fsSLo /tmp/go.tar.gz "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
    && echo "${GO_SHA256}  /tmp/go.tar.gz" | sha256sum -c - \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm -f /tmp/go.tar.gz \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/usr/local/go/bin:${PATH}"
RUN jenkins-plugin-cli --plugins workflow-aggregator git credentials-binding
RUN mkdir -p /usr/share/jenkins/ref/init.groovy.d
COPY --chown=jenkins:jenkins jenkins/init.groovy.d/01-admin.groovy /usr/share/jenkins/ref/init.groovy.d/01-admin.groovy
USER jenkins
